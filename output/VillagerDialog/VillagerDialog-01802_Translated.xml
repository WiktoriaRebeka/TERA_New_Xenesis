<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1446" huntingZoneId="72" voiceTypeId="148" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">Ser&amp;#237;a mejor que me dejaras supervisar el District de Veritas, &lt;PCCLASS:lcase&gt;.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;T&amp;#250;. El Elf! Necesito la autorizaci&amp;#243;n para entrar al District de Veritas.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#191;Qui&amp;#233;n? No importa. Todav&amp;#237;a tengo un largo camino por recorrer. &amp;#191;Mi autorizaci&amp;#243;n?</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#191;Extra&amp;#241;o? &amp;#191;Qu&amp;#233; quieres decir con eso?</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#191;T&amp;#250;? &amp;#161;Oh no, otra vez no!</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Ja! &amp;#161;Intenta seguir el ritmo!</Page>
    </Text>
</VillagerDialog>
