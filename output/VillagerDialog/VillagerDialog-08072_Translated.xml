<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="30000" huntingZoneId="2501" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Demasiado tarde! Ya han habitado un cuerpo.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Un ataque potente.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Ugh...</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Maldici&amp;#243;n, ha escapado.</Page>
    </Text>
    <Text id="112" endSocial="0">
        <Page social="0" voiceTypeId="0">Ir&amp;#233; tras Thulsa, el dios de la muerte. Oc&amp;#250;pate de este lugar.</Page>
    </Text>
    <Text id="113" endSocial="0">
        <Page social="0" voiceTypeId="0">Cuando termines, ven a ayudarme a detenerlos.</Page>
    </Text>
    <Text id="114" endSocial="0">
        <Page social="0" voiceTypeId="0">Haz tu mejor esfuerzo.</Page>
    </Text>
</VillagerDialog>
