<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1047" huntingZoneId="79" voiceTypeId="117" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="5">Nuestra prioridad es aplastar los cr&amp;#225;neos de los soldados de Thulsa y proteger Habere.&lt;BR&gt;&lt;BR&gt;No es ciencia cierta, no veo por qu&amp;#233; necesitamos ayuda exterior.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0">&amp;#161;Entendido!</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0">&amp;#161;Partimos hacia la Fournaise! &amp;#161;Soldados, a las armas!</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0">&amp;#161;Taur! Informa al oficial log&amp;#237;stico sobre las provisiones.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0">&amp;#161;Tahereh! Prepara a los soldados.</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0">&amp;#161;Movilicen a los hombres! &amp;#161;Vamos a la Fournaise!</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0">Yo voy al frente.</Page>
    </Text>
</VillagerDialog>
