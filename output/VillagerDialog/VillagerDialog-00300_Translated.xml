<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="502" huntingZoneId="27" voiceTypeId="291" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="291">&amp;#161;Por poco!&lt;BR&gt;Estos Humanos est&amp;#225;n sanos y salvos, as&amp;#237; que podemos regresar al pueblo.&lt;BR&gt;Podremos encargarnos de las mariposas despu&amp;#233;s de llevar a los aldeanos a un lugar seguro.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="291">&amp;#161;Puedo ayudarte!</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="291">Ven por aqu&amp;#237;.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="291">&amp;#191;Son estos todos los sobrevivientes?</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="291">&amp;#191;Qu&amp;#233; fue ese ruido?</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="291">No tengo m&amp;#225;s opci&amp;#243;n que usar este poder.</Page>
    </Text>
</VillagerDialog>
