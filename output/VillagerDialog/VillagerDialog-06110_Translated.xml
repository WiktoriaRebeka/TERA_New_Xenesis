<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1050" huntingZoneId="415" voiceTypeId="23" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="3">
        <Page social="3" voiceTypeId="0">&amp;#161;El sangrado no se detiene! &amp;#161;Necesito vendas! &amp;#161;Un torniquete! &amp;#161;R&amp;#225;pido!</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="0">Si se mueve, va a morir.</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="0">No estoy muy seguro de si llegar a la playa es algo bueno o malo.</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="0">No puedo hacer mucho por los ahogados.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">S&amp;#233; que duele. Trata de pensar en otra cosa. Piensa en tu hogar.</Page>
    </Text>
</VillagerDialog>
