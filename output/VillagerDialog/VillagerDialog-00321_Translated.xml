<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1016" huntingZoneId="27" voiceTypeId="10" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">&amp;#161;Por la diosa!&lt;BR&gt;&amp;#161;Me cuesta creer que queden sobrevivientes por aqu&amp;#237;!&lt;BR&gt;&amp;#161;Debemos huir lo antes posible antes de que regresen las mariposas!&lt;BR&gt;&amp;#161;Vamos, v&amp;#225;monos de aqu&amp;#237;!</Page>
    </Text>
    <Text id="101" endSocial="14">
        <Page social="4" voiceTypeId="0">&amp;#161;Mil gracias, querida diosa!</Page>
    </Text>
    <Text id="102" endSocial="14">
        <Page social="4" voiceTypeId="0">&amp;#161;Me preocupan mis camaradas!</Page>
    </Text>
    <Text id="103" endSocial="14">
        <Page social="4" voiceTypeId="0">S&amp;#225;lvalos, te lo ruego.</Page>
    </Text>
</VillagerDialog>
