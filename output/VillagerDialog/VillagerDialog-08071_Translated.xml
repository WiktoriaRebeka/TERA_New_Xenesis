<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="20100" huntingZoneId="2501" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Listo.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Mu&amp;#233;strate, dios de la muerte!</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Ja!</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">No importa.</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Sin un cuerpo, esto es un poco lamentable.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">Colabora conmigo y te dar&amp;#233; un cuerpo.</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Pues que as&amp;#237; sea! &amp;#161;Mu&amp;#233;strate!</Page>
    </Text>
    <Text id="108" endSocial="0">
        <Page social="0" voiceTypeId="0">Unan sus fuerzas y resucitar&amp;#225;n como una criatura poderosa.</Page>
    </Text>
    <Text id="109" endSocial="0">
        <Page social="0" voiceTypeId="0">S&amp;#237;ganme despu&amp;#233;s.&lt;BR&gt;Les otorgar&amp;#233; un poder a&amp;#250;n mayor.</Page>
    </Text>
</VillagerDialog>
