<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1056" huntingZoneId="415" voiceTypeId="10" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="3">
        <Page social="3" voiceTypeId="0">Ay&amp;#250;danos. Haz algo, no s&amp;#233; qu&amp;#233;, pero ay&amp;#250;danos.</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="0">Jam&amp;#225;s volver&amp;#233; a casa.</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="0">No pude salvar a nadie. Aunque de verdad lo intent&amp;#233;.</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Vamos a morir todos aqu&amp;#237;, en una isla que ni siquiera aparece en los mapas!</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Ya no vamos a retroceder! &amp;#161;Vamos!</Page>
    </Text>
</VillagerDialog>
