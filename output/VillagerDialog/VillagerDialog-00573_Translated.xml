    </Text>
    <Text id="101" huntingZoneId="60" endSocial="14" prevId="0" villagerId="1001">
        <Page social="4">&amp;#191;Buscas algo especial?</Page>
    </Text>
    <Text id="102" huntingZoneId="60" endSocial="14" prevId="0" villagerId="1001">
        <Page social="4">Mercanc&amp;#237;a honesta a un precio honesto.</Page>
