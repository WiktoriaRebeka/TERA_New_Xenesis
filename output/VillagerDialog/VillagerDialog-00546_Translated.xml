<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1012" huntingZoneId="59" voiceTypeId="24" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" huntingZoneId="59" endSocial="14" prevId="0" villagerId="1012">
        <Page social="4">No es como si alguien m&amp;#225;s se hubiera ofrecido como voluntario para averiguar por qu&amp;#233; los muertos salen de sus tumbas.&lt;BR&gt;&lt;BR&gt;Tengo un trabajo que hacer y lo har&amp;#233;. Por supuesto que voy a necesitar ayuda, soy un erudito, no un soldado.</Page>
    </Text>
    <Text id="10001" huntingZoneId="59" endSocial="0" prevId="0" villagerId="1012">
        <Page social="4">&amp;#161;Por todos los dioses!</Page>
    </Text>
    <Text id="10002" huntingZoneId="59" endSocial="0" prevId="0" villagerId="1012">
        <Page social="4">&amp;#161;El n&amp;#250;cleo est&amp;#225; corrompido con energ&amp;#237;a espiritual!</Page>
    </Text>
    <Text id="10003" huntingZoneId="59" endSocial="0" prevId="0" villagerId="1012">
        <Page social="4">Eso explica por qu&amp;#233; los muertos deambulan por el bosque.</Page>
    </Text>
</VillagerDialog>
