<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="3602" huntingZoneId="78" voiceTypeId="114" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="239">&amp;#161;Bah! L&amp;#225;rgate de mi vista, lamebotas.&lt;BR&gt;&lt;BR&gt;Vuelve a verme cuando hayas demostrado tu val&amp;#237;a.</Page>
    </Text>
    <Text id="2" endSocial="14">
        <Page social="4" voiceTypeId="240">Supongo que podr&amp;#237;a separarme de algunos objetos.</Page>
    </Text>
    <Text id="3" endSocial="14">
        <Page social="4" voiceTypeId="241">La gente habla de ti.&lt;BR&gt;&lt;BR&gt;&amp;#161;Conoces lo tuyo! &amp;#191;Buscas algo en particular?</Page>
    </Text>
    <Text id="4" endSocial="14">
        <Page social="4" voiceTypeId="241">&amp;#161;Sigue as&amp;#237;! Si tan solo nuestros soldados tuvieran al menos la mitad de tu talento.</Page>
    </Text>
</VillagerDialog>
