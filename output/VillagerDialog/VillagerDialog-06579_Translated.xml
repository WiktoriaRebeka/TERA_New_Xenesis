<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1101" huntingZoneId="505" voiceTypeId="41" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="41">&amp;#161;Hay que evacuar a los supervivientes primero! &amp;#161;De inmediato!</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="41">Es importante mantener la calma, sobre todo en una situaci&amp;#243;n as&amp;#237;.</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="41">&amp;#161;A sus &amp;#243;rdenes!</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="41">Vamos a escapar. Ve inmediatamente a ver a Seir.</Page>
    </Text>
    <Text id="5" endSocial="0">
        <Page social="0" voiceTypeId="41">Eh, peque&amp;#241;o. Es peligroso. Por eso tambi&amp;#233;n vamos a ver a Seir, como este hombre.</Page>
    </Text>
    <Text id="6" endSocial="0">
        <Page social="0" voiceTypeId="41">Se&amp;#241;or comandante, &amp;#191;se encuentra bien? &amp;#161;Se&amp;#241;or comandante!</Page>
    </Text>
</VillagerDialog>
