<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1000" huntingZoneId="2504" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">Mjum...</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="0">Ser&amp;#237;a absurdo continuar...&lt;BR&gt;Dej&amp;#233;moslo as&amp;#237;, &amp;#191;qu&amp;#233; te parece?</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="0">Por suerte, se retiraron sin demasiada resistencia.</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="0">Entonces...&lt;BR&gt;&amp;#191;Est&amp;#225;n todos ilesos?</Page>
    </Text>
    <Text id="5" endSocial="0">
        <Page social="0" voiceTypeId="0">Deber&amp;#237;amos largarnos lo antes posible.</Page>
    </Text>
    <Text id="6" endSocial="0">
        <Page social="0" voiceTypeId="0">Busquemos una salida.</Page>
    </Text>
    <Text id="7" endSocial="0">
        <Page social="0" voiceTypeId="0">Ir&amp;#233; por ah&amp;#237;.&lt;BR&gt;&amp;#191;Me acompa&amp;#241;as?</Page>
    </Text>
    <Text id="8" endSocial="0">
        <Page social="0" voiceTypeId="0">Este camino deber&amp;#237;a sacarnos de aqu&amp;#237;.</Page>
    </Text>
    <Text id="9" endSocial="0">
        <Page social="0" voiceTypeId="0">Ir&amp;#233; a buscar a Elion.&lt;BR&gt;Vayan ustedes adelante.</Page>
    </Text>
</VillagerDialog>
