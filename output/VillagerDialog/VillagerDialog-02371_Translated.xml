<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1006" huntingZoneId="83" voiceTypeId="4" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" huntingZoneId="83" endSocial="14" prevId="0" villagerId="1006">
        <Page social="4" voiceTypeId="0">Es imposible confiar en los wendigos. &amp;#161;Por supuesto que quieren apoderarse de los fragmentos!&lt;BR&gt;&lt;BR&gt; &amp;#161;Como si la explotaci&amp;#243;n masiva de un recurso fuera perjudicial! &amp;#161;Pff!</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Oh, &amp;#191;est&amp;#225;n listos?</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Entonces, hay que colocar los peces en este recipiente... as&amp;#237;, antes de a&amp;#241;adir agua limpia...</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Y listo.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Todo el mundo ha tra&amp;#237;do algo para el guiso!</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Primero hay que hervir el agua.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">Luego cortamos el salm&amp;#243;n del regente y lo a&amp;#241;adimos a la sopa.</Page>
    </Text>
</VillagerDialog>
