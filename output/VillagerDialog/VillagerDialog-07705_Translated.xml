<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="20302" huntingZoneId="2001" voiceTypeId="294" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="4">
        <Page social="4" voiceTypeId="294">Debemos centrar nuestros esfuerzos en rescatar a los aldeanos secuestrados.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Todav&amp;#237;a quedan muchos Human por salvar.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="4" voiceTypeId="0">Exactamente. Divid&amp;#225;monos en dos grupos: unos salvan a los Human mientras los otros exploran los alrededores.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">&lt;PCNAME&gt; y yo iremos a buscar a Jelena y a los aldeanos.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="7" voiceTypeId="0">Bien. En marcha.</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Thro, Aurl, les encargo a los dem&amp;#225;s.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">&lt;PCNAME&gt;, deber&amp;#237;amos buscar a Jelena.</Page>
    </Text>
</VillagerDialog>
