<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="8200" huntingZoneId="122" voiceTypeId="67" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="3" huntingZoneId="121" endSocial="14" prevId="0" villagerId="8100">
        <Page social="4">&amp;#161;Hola! Te ves muy rojo. &amp;#191;C&amp;#243;mo podemos ayudarte hoy?</Page>
    </Text>
    <Text id="20" huntingZoneId="121" endSocial="14" prevId="0" villagerId="8100">
        <Page social="4">&amp;#161;Bienvenido! A tu servicio, cueste lo que cueste.</Page>
    </Text>
    <Text id="21" huntingZoneId="121" endSocial="14" prevId="0" villagerId="8100">
        <Page social="4">&amp;#161;Hola! &amp;#191;Debo coser tus heridas y vendar tus quemaduras?</Page>
    </Text>
    <Text id="22" huntingZoneId="121" endSocial="14" prevId="0" villagerId="8100">
        <Page social="4">&amp;#161;Hola! &amp;#191;Cu&amp;#225;l es la carga que te estorba, aparte del oro?</Page>
    </Text>
    <Text id="23" huntingZoneId="121" endSocial="14" prevId="0" villagerId="8100">
        <Page social="4">&amp;#161;Hola! Estoy listo para servirte y curar tus heridas. &amp;#191;Por d&amp;#243;nde empezamos?</Page>
    </Text>
    <Text id="1" huntingZoneId="121" endSocial="14" prevId="0" villagerId="8100">
        <Page social="4">Parece que tu cuenta no est&amp;#225; equilibrada. Tu sangre debe seguir circulando.</Page>
    </Text>
</VillagerDialog>
