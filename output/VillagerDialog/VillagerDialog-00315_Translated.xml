<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1000" huntingZoneId="27" voiceTypeId="95" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">Sabemos d&amp;#243;nde est&amp;#225; la aeronave.&lt;BR&gt;Recorrimos la cresta de la monta&amp;#241;a y la vimos bastante r&amp;#225;pido.&lt;BR&gt;En cambio, el camino de regreso nos tom&amp;#243; una eternidad.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Buen trabajo!</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Gracias a ti, ya no tenemos de qu&amp;#233; preocuparnos.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;No hay ni un minuto que perder!</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;R&amp;#225;pido! &amp;#161;Me preocupan los aldeanos!</Page>
    </Text>
</VillagerDialog>
