<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1011" huntingZoneId="71" voiceTypeId="44" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" huntingZoneId="71" endSocial="0" prevId="0" villagerId="1011">
        <Page social="0" voiceTypeId="0">Los Barakas se interesan por todo tipo de cosas... Nunca antes hab&amp;#237;a visto un libro como este.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#191;Oh, este libro?</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Cuidado! Est&amp;#225; maldito.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Atrae el mal de ojo hacia su propietario.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Pero bueno, escuch&amp;#233; que imprimieron miles de ejemplares hace a&amp;#241;os.</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Seg&amp;#250;n los rumores, este libro est&amp;#225; hecho con cuero popori...</Page>
    </Text>
</VillagerDialog>
