<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="220021" huntingZoneId="122" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">No tenemos ninguna raz&amp;#243;n para hablar, &amp;#191;est&amp;#225;s de acuerdo?</Page>
    </Text>
    <Text id="2" endSocial="14">
        <Page social="4" voiceTypeId="132">Solo la serenidad puede conducirte entre los tuyos.</Page>
    </Text>
    <Text id="3" endSocial="14">
        <Page social="4" voiceTypeId="0">&amp;#191;No crees que tienes mala suerte con los Baraka?</Page>
    </Text>
    <Text id="4" endSocial="14">
        <Page social="4" voiceTypeId="132">El trabajo en equipo es lo que m&amp;#225;s nos importa. Entrena un poco m&amp;#225;s y luego vuelve a vernos.</Page>
    </Text>
    <Text id="6" endSocial="14">
        <Page social="4" voiceTypeId="132">&amp;#161;Un d&amp;#237;a pr&amp;#243;ximo, la luz llegar&amp;#225; hasta los lugares m&amp;#225;s oscuros!</Page>
    </Text>
</VillagerDialog>
