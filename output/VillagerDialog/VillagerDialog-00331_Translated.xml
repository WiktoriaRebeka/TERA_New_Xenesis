<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1105" huntingZoneId="27" voiceTypeId="175" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="4" voiceTypeId="175">&amp;#161;Por todos los dioses! &lt;BR&gt;&amp;#191;Ves esa peque&amp;#241;a abertura de donde escapan mariposas regularmente? &lt;BR&gt;&lt;BR&gt;Conduce a su sala de cr&amp;#237;a. Sin duda encontraremos all&amp;#237; algunas pistas para desarrollar una cura contra la cristalizaci&amp;#243;n.&lt;BR&gt;&lt;BR&gt;&amp;#161;Me alegra mucho que hayamos encontrado este lugar!</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Ya no aguanto m&amp;#225;s. Tengo demasiada curiosidad. Tomar&amp;#233; la iniciativa.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#191;Qu&amp;#233; fue eso? &amp;#191;Lo viste t&amp;#250; tambi&amp;#233;n?</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Las mariposas salieron por esa peque&amp;#241;a abertura.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Por aqu&amp;#237;! &amp;#161;Vengan por aqu&amp;#237;!</Page>
    </Text>
</VillagerDialog>
