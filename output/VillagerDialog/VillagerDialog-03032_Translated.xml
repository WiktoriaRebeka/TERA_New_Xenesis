<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="2012" huntingZoneId="182" voiceTypeId="134" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="5" voiceTypeId="0">&amp;#161;Ni un paso m&amp;#225;s, extranj{@gender:er/&amp;#232;re}! &amp;#191;Qu&amp;#233; quieres?</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;En camino a Highwatch!</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;S&amp;#233; discr{@gender:et/&amp;#232;te}!</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Las fuerzas de Parth han bloqueado este camino. Sin embargo, tan pronto como la resistencia de Kaidun est&amp;#233; lista para ponerse en marcha, la m&amp;#225;quina de asedio despejar&amp;#225; la obstrucci&amp;#243;n.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Tenemos que hablar.</Page>
    </Text>
</VillagerDialog>
