    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="237">No s&amp;#233; qu&amp;#233; est&amp;#225;s haciendo aqu&amp;#237;, pero no interfieras con nuestras actividades.</Page>
    </Text>
    <Text id="2" endSocial="14">
        <Page social="4" voiceTypeId="237">Nada como acuerdos mutuamente beneficiosos, &amp;#191;eh?</Page>
    </Text>
    <Text id="3" endSocial="14">
        <Page social="4" voiceTypeId="238">Los negocios est&amp;#225;n floreciendo gracias a ti. Eres un activo para nuestra organizaci&amp;#243;n.</Page>
    </Text>
    <Text id="4" endSocial="14">
        <Page social="4" voiceTypeId="238">Los ingresos suben, los gastos bajan... eres una de nuestras mejores inversiones.</Page>
    </Text>
</VillagerDialog>
