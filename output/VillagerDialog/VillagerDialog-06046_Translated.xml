<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="5001" huntingZoneId="411" voiceTypeId="189" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">&amp;#191;Es esta tu primera vez aqu&amp;#237;?&lt;BR&gt;&lt;BR&gt;Este lugar re&amp;#250;ne a los mejores herreros del continente.&lt;BR&gt;&lt;BR&gt;&amp;#201;chale un vistazo a tu alrededor.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Bien! &amp;#191;Empezamos?</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Mmm... A&amp;#250;n no. &amp;#161;No es suficiente!</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Muchachos!</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Ahora, la esencia del n&amp;#250;cleo...</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Por fin lo logr&amp;#233;!</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Ya est&amp;#225; hecho!</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0" voiceTypeId="0">Oh, Elion, ha pasado tanto tiempo.</Page>
    </Text>
</VillagerDialog>
