<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="3002" huntingZoneId="506" voiceTypeId="25" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="4">
        <Page social="22" voiceTypeId="25">&amp;#161;D&amp;#233;jame entrar a la Salle de banquet!&lt;BR&gt;Tengo algo importante que comunicarle a Seir.</Page>
    </Text>
    <Text id="2" endSocial="4">
        <Page social="0" voiceTypeId="25">&amp;#161;D&amp;#233;jame entrar, por piedad! Necesito a toda costa &lt;BR&gt;informarle algo a Seir.</Page>
    </Text>
    <Text id="3" endSocial="14">
        <Page social="0" voiceTypeId="25">Si esto contin&amp;#250;a as&amp;#237;, el mundo... &amp;#161;Arborea se encamina a su perdici&amp;#243;n! &amp;#161;Por favor, d&amp;#233;jame entrar! &amp;#161;Te lo suplico!</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="25">Ah, diosa Velik... &amp;#191;Acaso ha sonado el fin de Velika y de Arborea?</Page>
    </Text>
    <Text id="5" endSocial="0">
        <Page social="0" voiceTypeId="25">De todo... &amp;#161;El fin de todas las cosas!</Page>
    </Text>
    <Text id="6" endSocial="0">
        <Page social="0" voiceTypeId="25">&amp;#161;Eh, t&amp;#250;! &amp;#161;T&amp;#250;, de ah&amp;#237;!</Page>
    </Text>
</VillagerDialog>
