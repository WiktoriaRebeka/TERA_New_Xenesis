<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="40011000" huntingZoneId="808" voiceTypeId="95" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Crees que solo tengo guardias a mi disposici&amp;#243;n!</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">&lt;font color='#FF0000'&gt;&amp;#161;Siente este dolor penetrante!&lt;/font&gt;</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">&lt;font color='#FF0000'&gt;&amp;#161;Prueba un poco del poder de la magia de sangre!&lt;/font&gt;</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">&lt;font color='#FF0000'&gt;&amp;#161;Mis drenadores de sangre te acabar&amp;#225;n!&lt;/font&gt;</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Basta de juegos.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Qu&amp;#233; sorpresa! Me impresionas... pero no lo suficiente como &amp;#273;&amp;#7875; perdonarte la vida.</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;C&amp;#243;mo te atreves! &amp;#161;M&amp;#225;tenlos! &amp;#161;M&amp;#225;tenlos a todos!</Page>
    </Text>
    <Text id="108" endSocial="0">
        <Page social="0" voiceTypeId="0">&lt;font color='#FF0000'&gt;&amp;#161;No debiste venir!&lt;/font&gt;</Page>
    </Text>
    <Text id="109" endSocial="0">
        <Page social="0" voiceTypeId="0">&lt;font color='#FF0000'&gt;&amp;#161;Esta ser&amp;#225; tu tumba!&lt;/font&gt;</Page>
    </Text>
    <Text id="110" endSocial="0">
        <Page social="0" voiceTypeId="0">Para pasar, debes pagar... &amp;#161;con tu vida!</Page>
    </Text>
</VillagerDialog>
