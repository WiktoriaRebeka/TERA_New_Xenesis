<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1004" huntingZoneId="181" voiceTypeId="134" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="4">
        <Page social="4" voiceTypeId="134">Los j&amp;#243;venes investigadores me dicen que Verikam ha desaparecido... y podr&amp;#237;a habernos dejado.&lt;BR&gt;&lt;BR&gt;Me pregunto si los ciudadanos de Hautegarde me pedir&amp;#225;n que sea el nuevo Venerable...</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="4" voiceTypeId="134">Esto est&amp;#225; tardando m&amp;#225;s de lo que recordaba. &amp;#191;Olvid&amp;#233; algo?</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="4" voiceTypeId="134">No es tan simple como parece.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="4" voiceTypeId="134">Paciencia. La poci&amp;#243;n est&amp;#225; casi lista.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="4" voiceTypeId="134">Era mucho m&amp;#225;s f&amp;#225;cil cuando a&amp;#250;n era un joven Baraka...</Page>
    </Text>
</VillagerDialog>
