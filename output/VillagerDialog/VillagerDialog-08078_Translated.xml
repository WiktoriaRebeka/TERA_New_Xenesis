<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="3000" huntingZoneId="2502" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Ah, est&amp;#225;s aqu&amp;#237;!</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="0">Thulsa rob&amp;#243; el fragmento de la diosa en la Tour de Shara.</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="0">No s&amp;#233; qu&amp;#233; planea hacer con &amp;#233;l, pero sus intenciones definitivamente no son buenas.</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="0">Debemos recuperarlo antes de que sea demasiado tarde.</Page>
    </Text>
    <Text id="5" endSocial="0">
        <Page social="0" voiceTypeId="0">Hablemos del resto en el camino. &lt;BR&gt;S&amp;#237;gueme.</Page>
    </Text>
    <Text id="6" endSocial="0">
        <Page social="0" voiceTypeId="0">Ah, ahora que lo pienso... La mujer que estaba con Thulsa...</Page>
    </Text>
    <Text id="7" endSocial="0">
        <Page social="0" voiceTypeId="0">C&amp;#243;mo decirlo... &lt;BR&gt;Todo esto no me presagia nada bueno.</Page>
    </Text>
    <Text id="8" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Oh, no!&lt;BR&gt;&amp;#161;Esto se va a poner feo!</Page>
    </Text>
</VillagerDialog>
