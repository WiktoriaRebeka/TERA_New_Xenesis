<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1017" huntingZoneId="428" voiceTypeId="127" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">Debe de ser el Laboratorio de Malachai. Emana de &amp;#233;l una energ&amp;#237;a m&amp;#225;gica mal&amp;#233;fica.&lt;BR&gt;&lt;BR&gt;Mantente alerta.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">La magia de Malachai se activar&amp;#225; tan pronto como invoques el teleportal.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Podr&amp;#237;a resultar peligroso. Cuidado...</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">La magia se ha activado.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Pase lo que pase, &amp;#161;no entres en p&amp;#225;nico!</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Poderoso Balder, dios del sol!</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Somete al mal y d&amp;#243;blalo a tu voluntad!</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0" voiceTypeId="0">Voy a prisionear este mal dentro de m&amp;#237;. &amp;#161;Aprovechen este respiro para ocuparse del demonio!</Page>
    </Text>
    <Text id="108" endSocial="0">
        <Page social="0" voiceTypeId="0">Argh... Les dejo que se encarguen del resto.</Page>
    </Text>
    <Text id="109" endSocial="0">
        <Page social="0" voiceTypeId="0">He aprisionado este poder mal&amp;#233;fico dentro de m&amp;#237;...</Page>
    </Text>
    <Text id="110" endSocial="0">
        <Page social="0" voiceTypeId="0">He aqu&amp;#237; el teleportal que lleva a la Galer&amp;#237;a de Sirjuka.</Page>
    </Text>
    <Text id="111" endSocial="0">
        <Page social="0" voiceTypeId="0">Har&amp;#233; llegar esta piedra m&amp;#225;gica a Allemantheia.</Page>
    </Text>
    <Text id="112" endSocial="0">
        <Page social="0" voiceTypeId="0">Nos volveremos a ver en Allemantheia.</Page>
    </Text>
</VillagerDialog>
