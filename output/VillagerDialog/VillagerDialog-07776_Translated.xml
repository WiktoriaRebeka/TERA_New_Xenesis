<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="100" huntingZoneId="2002" voiceTypeId="324" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="1">
        <Page social="2" voiceTypeId="324">&amp;#161;Oh, lo alabado sea la diosa!&lt;BR&gt;No puedo creer que extranjeros vengan a salvarnos.</Page>
    </Text>
    <Text id="101" endSocial="1">
        <Page social="2" voiceTypeId="324">Ustedes... Ustedes son extranjeros...</Page>
    </Text>
    <Text id="102" endSocial="1">
        <Page social="2" voiceTypeId="324">Conozco a un habitante del pantano que podr&amp;#225; ayudarte a conseguir el remedio.</Page>
    </Text>
    <Text id="103" endSocial="1">
        <Page social="2" voiceTypeId="324">Ah, para eso, p&amp;#237;dele ayuda a Bashik.</Page>
    </Text>
    <Text id="104" endSocial="1">
        <Page social="2" voiceTypeId="324">&amp;#191;Tu compa&amp;#241;ero? No, no lo he visto.</Page>
    </Text>
    <Text id="105" endSocial="1">
        <Page social="2" voiceTypeId="324">Sigue el camino y terminar&amp;#225;s por encontrarlo.</Page>
    </Text>
</VillagerDialog>
