    <Text id="1" endSocial="3">
        <Page social="5" voiceTypeId="58">&lt;PCNAME&gt;, vamos a hacer de ti un ejemplo para todos los soldados de la Federaci&amp;#243;n.</Page>
    </Text>
    <Text id="101" endSocial="0">
