    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Bienvenido de nuevo, &lt;PCNAME&gt;.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Llegas en el momento oportuno... tenemos que hablar.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Estoy revisando los informes que nos llegan del frente.</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Nos falta informaci&amp;#243;n para poder localizar a Shandra Manaya.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">Quiero que me acompa&amp;#241;es.</Page>
    </Text>
    <Text id="110" endSocial="0">
        <Page social="0" voiceTypeId="0">Ay&amp;#250;dalos. S&amp;#233; que al final pondr&amp;#225;s fin a la guerra.</Page>
    </Text>
