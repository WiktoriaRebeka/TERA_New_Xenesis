<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="10500" huntingZoneId="2501" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="110" endSocial="0">
        <Page social="0" voiceTypeId="0">Pero miren qui&amp;#233;n est&amp;#225; aqu&amp;#237;...&lt;BR&gt;&amp;#191;No es acaso Lok, el que me encerr&amp;#243;?</Page>
    </Text>
    <Text id="111" endSocial="0">
        <Page social="0" voiceTypeId="0">Malditos bribones.</Page>
    </Text>
    <Text id="112" endSocial="0">
        <Page social="0" voiceTypeId="0">Voy a destruirlos a todos.</Page>
    </Text>
    <Text id="113" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Ja!</Page>
    </Text>
    <Text id="114" endSocial="0">
        <Page social="0" voiceTypeId="0">Nada mal.</Page>
    </Text>
    <Text id="120" endSocial="0">
        <Page social="0" voiceTypeId="0">Preferir&amp;#237;a mil veces destrozarte...</Page>
    </Text>
    <Text id="121" endSocial="0">
        <Page social="0" voiceTypeId="0">Pero aqu&amp;#237; hay una fuerza a&amp;#250;n mayor de la que debo ocuparme. &amp;#161;Je, je, je!</Page>
    </Text>
    <Text id="122" endSocial="0">
        <Page social="0" voiceTypeId="0">Pero les dejar&amp;#233; un peque&amp;#241;o regalo.</Page>
    </Text>
</VillagerDialog>
