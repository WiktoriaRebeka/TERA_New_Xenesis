<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1019" huntingZoneId="415" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="3">
        <Page social="3">Ay&amp;#250;dame. Me duele much&amp;#237;simo.</Page>
    </Text>
    <Text id="2" endSocial="3">
        <Page social="3">Dime la verdad, camarada. Vamos a morir todos aqu&amp;#237;, &amp;#191;verdad?</Page>
    </Text>
    <Text id="3" endSocial="3">
        <Page social="3">Dile a Lohra que la amo.</Page>
    </Text>
    <Text id="4" endSocial="3">
        <Page social="3">Intentaba empujar a la gente para que subiera al bote salvavidas, pero estaba resbaloso y no ten&amp;#237;a buen agarre.</Page>
    </Text>
</VillagerDialog>
