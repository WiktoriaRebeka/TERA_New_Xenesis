<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="2000" huntingZoneId="2502" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">Bien, ya no falta mucho...&lt;BR&gt;&amp;#161;Recupero toda mi fuerza!</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Jajajaja! &lt;BR&gt;&amp;#161;No he llegado tan lejos para dejar que me pongas trabas!</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Argh... este maldito c&amp;#237;rculo de destierro...!&lt;BR&gt;&amp;#161;Maldici&amp;#243;n!</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="0">Con que quieres enfrentarme hasta el final...</Page>
    </Text>
    <Text id="5" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#191;Eh?</Page>
    </Text>
    <Text id="6" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Shandra!</Page>
    </Text>
    <Text id="7" endSocial="0">
        <Page social="0" voiceTypeId="0">No...&lt;BR&gt; Jam&amp;#225;s deb&amp;#237; haberle confiado nada a nadie.</Page>
    </Text>
    <Text id="8" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Te mostrar&amp;#233; lo que le pasa a los que se atreven a buscarme pelea!&lt;BR&gt;&amp;#161;Y empiezo contigo!</Page>
    </Text>
</VillagerDialog>
