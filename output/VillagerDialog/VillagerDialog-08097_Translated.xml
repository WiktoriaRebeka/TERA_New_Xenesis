<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="10100" huntingZoneId="2503" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Ja, ja, ja, pobre imb&amp;#233;cil!</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">No tienes la m&amp;#225;s m&amp;#237;nima idea de lo que se est&amp;#225; tramando aqu&amp;#237;, &amp;#191;eh?</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Ca&amp;#237;ste en la trampa de mi ilusi&amp;#243;n.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Te muestro a mi amada y a mis subordinados con los que cre&amp;#237;as haber estado experimentando.</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Y soy Paesyn, el h&amp;#233;roe de Valkyon!</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Aargh!</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0" voiceTypeId="0">Ya que las encantadoras damiselas se han ido...</Page>
    </Text>
    <Text id="108" endSocial="0">
        <Page social="0" voiceTypeId="0">...&amp;#161;Podr&amp;#233; exterminarte!</Page>
    </Text>
</VillagerDialog>
