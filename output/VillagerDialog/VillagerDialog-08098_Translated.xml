<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="10190" huntingZoneId="2503" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Por suerte, &amp;#161;todav&amp;#237;a no era demasiado tarde!</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Dkurion! &amp;#161;Te detendr&amp;#233; y cambiar&amp;#233; el destino!</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Un &amp;#233;xito rotundo!</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Vengo de otro mundo. Te explicar&amp;#233; todo eso m&amp;#225;s tarde.</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">No tenemos tiempo que perder. Sigue mis palabras.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Los guiar&amp;#233; a todos al otro mundo!</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#161;Debes derrotar a Dkurion!</Page>
    </Text>
</VillagerDialog>
