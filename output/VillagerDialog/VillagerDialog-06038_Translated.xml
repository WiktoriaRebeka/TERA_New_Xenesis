<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="5005" huntingZoneId="410" voiceTypeId="137" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4">Padre...&lt;BR&gt;&lt;BR&gt;... Te vengar&amp;#233;.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0">&amp;#161;Ayudante, re&amp;#250;ne a las tropas!</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0">&amp;#191;Qu&amp;#233; unidades se pueden movilizar m&amp;#225;s r&amp;#225;pido?</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0">&amp;#191;Qui&amp;#233;n?</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0">&amp;#161;T&amp;#250;!</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0">Esa fue tu &amp;#250;ltima risa, payaso.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0">Es imposible... &amp;#191;De verdad son los cuernos de mi padre?</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0">&amp;#161;Guardias! &amp;#161;M&amp;#225;tenlo!</Page>
    </Text>
    <Text id="108" endSocial="0">
        <Page social="0">&amp;#161;Alabada sea la Doncella del Escudo!</Page>
    </Text>
</VillagerDialog>
