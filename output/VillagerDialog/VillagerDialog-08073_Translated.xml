<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="30100" huntingZoneId="2501" voiceTypeId="290" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" huntingZoneId="2501" endSocial="0" prevId="0" villagerId="30100">
        <Page social="4" voiceTypeId="290">Necesito tu fuerza.&lt;BR&gt;&lt;BR&gt;&amp;#191;Cuentas con ayudarme?</Page>
    </Text>
    <Text id="2" huntingZoneId="2501" endSocial="0" prevId="0" villagerId="30100">
        <Page social="4" voiceTypeId="290">Te lo agradezco.&lt;BR&gt;&lt;BR&gt;Te dejo a cargo de explorar la zona.&lt;BR&gt;&lt;BR&gt;Intentar&amp;#233; neutralizar el poder del dios de la muerte que estaba sellado aqu&amp;#237;.&lt;HAGO LO POSIBLE.&gt;&lt;/TEXTBUTTON&gt;&lt;/HAGO LO POSIBLE.&gt;&lt;ENTENDIDO.&gt;&lt;/EVENTPAGEBUTTON&gt;&lt;/ENTENDIDO.&gt;</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Una fuerza sagrada emana de ti.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Me llamo Lok.&lt;BR&gt;Soy el dios que posee la llave que sella el mundo de los dioses.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Si este poder llega a liberarse, es muy probable que el mundo colapse.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#191;Podr&amp;#237;as ayudarme?</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Te lo agradezco.&lt;BR&gt;Espero que lo logres.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">Av&amp;#237;same cuando est&amp;#233;s listo.</Page>
    </Text>
</VillagerDialog>
