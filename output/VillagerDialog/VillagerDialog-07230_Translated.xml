<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="103" huntingZoneId="827" voiceTypeId="34" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="4">
        <Page social="4" voiceTypeId="34">Cuando termine el sue&amp;#241;o experimental, &amp;#161;crecer&amp;#233; y me har&amp;#233; m&amp;#225;s fuerte! &amp;#161;Entonces tendr&amp;#225;s que obedecer mis &amp;#243;rdenes!</Page>
    </Text>
    <Text id="100" endSocial="0">
        <Page social="0" voiceTypeId="0">Tiaran, nacido del dolor y ba&amp;#241;ado en luz.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Una vida en los sue&amp;#241;os, antes de que lleguen a su fin.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Tus milagros nos ofrecen nuestra Visi&amp;#243;n de &amp;#233;ter.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">La Visi&amp;#243;n nos revela el mundo con el que los dioses sue&amp;#241;an.</Page>
    </Text>
    <Text id="200" endSocial="0">
        <Page social="0" voiceTypeId="0">No me da buena espina...</Page>
    </Text>
</VillagerDialog>
