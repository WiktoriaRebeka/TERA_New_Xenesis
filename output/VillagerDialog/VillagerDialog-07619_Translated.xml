    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="95">A&amp;#250;n tenemos mucho trabajo por hacer. Quedan m&amp;#225;s aldeanos por rescatar.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">&amp;#191;Sigues aqu&amp;#237;?</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Ah, &amp;#191;los Humans estaban prisioneros en otra parte?</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Tambi&amp;#233;n vi prisioneros all&amp;#237;, en el criadero de larvas.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Regresar&amp;#233; al criadero de larvas.</Page>
    </Text>
</VillagerDialog>
