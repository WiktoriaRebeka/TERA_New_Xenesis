<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="10041" huntingZoneId="84" voiceTypeId="269" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="269">Salut à vous ! Je m'appelle Hasmina et suis membre du Mysterium.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">L'assaut des argons a tout chamboulé.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Il a laissé des plaies béantes, y compris dans mon existence.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">C'est par une intervention divine que nous avons maintenant l'occasion d'éradiquer les argons.</Page>
    </Text>
</VillagerDialog>
