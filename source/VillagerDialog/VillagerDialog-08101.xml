    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Paesyn !</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Mon cher Paesyn ! Votre Zolyn adorée est ici !</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Ah, mon Paesyn ! Zolyn trouve cet endroit bien trop lugubre et elle va donc s'en aller !</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Paesyn, je vous aime beaucoup !</Page>
    </Text>
