<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="10500" huntingZoneId="2501" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="110" endSocial="0">
        <Page social="0" voiceTypeId="0">Mais qui voilà donc...&lt;BR&gt;Ne serait-ce pas Lok, celui qui m'a scellé ?</Page>
    </Text>
    <Text id="111" endSocial="0">
        <Page social="0" voiceTypeId="0">Maudits vauriens.</Page>
    </Text>
    <Text id="112" endSocial="0">
        <Page social="0" voiceTypeId="0">Je vais tous vous anéantir.</Page>
    </Text>
    <Text id="113" endSocial="0">
        <Page social="0" voiceTypeId="0">Ha !</Page>
    </Text>
    <Text id="114" endSocial="0">
        <Page social="0" voiceTypeId="0">Pas mal.</Page>
    </Text>
    <Text id="120" endSocial="0">
        <Page social="0" voiceTypeId="0">Je préfèrerais largement vous déchiqueter...</Page>
    </Text>
    <Text id="121" endSocial="0">
        <Page social="0" voiceTypeId="0">Mais il y a là une force encore plus grande dont je dois m'occuper. Hé hé hé !</Page>
    </Text>
    <Text id="122" endSocial="0">
        <Page social="0" voiceTypeId="0">Mais je vous laisse un petit cadeau.</Page>
    </Text>
</VillagerDialog>
