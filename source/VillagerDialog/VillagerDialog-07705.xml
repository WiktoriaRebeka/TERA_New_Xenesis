<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="20302" huntingZoneId="2001" voiceTypeId="294" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="4">
        <Page social="4" voiceTypeId="294">Nous devons focaliser nos efforts sur le sauvetage des villageois enlevés.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Il reste encore beaucoup d'Humains à sauver.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="4" voiceTypeId="0">Tout à fait. Répartisson-nous en deux groupes : les uns sauvent les Humains tandis que les autres explorent les environs.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">&lt;PCNAME&gt; et moi allons chercher Jelena et les villageois.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="7" voiceTypeId="0">Bien. Allons-y.</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Thro, Aurl, je vous confie les autres.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">&lt;PCNAME&gt;, nous devrions chercher Jelena.</Page>
    </Text>
</VillagerDialog>
