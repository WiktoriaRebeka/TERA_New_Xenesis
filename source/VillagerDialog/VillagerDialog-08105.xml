<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1000" huntingZoneId="2504" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">Hmm...</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="0">Il serait absurde de continuer...&lt;BR&gt;Tenons-en nous là, qu'en dites-vous ?</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="0">Par chance, ils ont battu en retraite sans trop de résistance.</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="0">Alors...&lt;BR&gt;Tout le monde est indemne ?</Page>
    </Text>
    <Text id="5" endSocial="0">
        <Page social="0" voiceTypeId="0">Nous devrions déguerpir au plus vite.</Page>
    </Text>
    <Text id="6" endSocial="0">
        <Page social="0" voiceTypeId="0">Cherchons une sortie.</Page>
    </Text>
    <Text id="7" endSocial="0">
        <Page social="0" voiceTypeId="0">Je vais passer par-là.&lt;BR&gt;Vous m'accompagnez ?</Page>
    </Text>
    <Text id="8" endSocial="0">
        <Page social="0" voiceTypeId="0">Ce chemin devrait nous mener dehors.</Page>
    </Text>
    <Text id="9" endSocial="0">
        <Page social="0" voiceTypeId="0">Je vais chercher Élion.&lt;BR&gt;Partez donc devant.</Page>
    </Text>
</VillagerDialog>
