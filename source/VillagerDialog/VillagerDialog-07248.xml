<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="226" huntingZoneId="827" voiceTypeId="282" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="4">
        <Page social="4" voiceTypeId="282">&lt;PCNAME&gt;&amp;nbsp;! Je suis si heureuse que vous soyez là&amp;nbsp;! Venez donc à côté de moi.</Page>
    </Text>
    <Text id="100" endSocial="0">
        <Page social="0" voiceTypeId="0">Tiaran, né du chagrin et baigné de lumière.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Une vie dans les songes, avant qu'ils ne s'achèvent.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Tes miracles nous offrent notre Vision d'éther.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">La Vision nous révèle le monde dont les dieux rêvent.</Page>
    </Text>
    <Text id="200" endSocial="0">
        <Page social="0" voiceTypeId="0">Je... j'ai le vertige.</Page>
    </Text>
</VillagerDialog>
