    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Aaaaaaaah !</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Fovarth, nous avons rassemblé tous les matériaux. Confectionnez l'enclume.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Bien joué, Fovarth. Et maintenant, vous devez aider &lt;PCNAME&gt;.</Page>
