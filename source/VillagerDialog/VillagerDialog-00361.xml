<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="5016" huntingZoneId="27" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">Je dois être reconnaissant d'être encore en vie.&lt;BR&gt;Les temps à venir s'annoncent bien tragiques pour nous tous...</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Élion ? C'est bien vous ?</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Quelle surprise de rencontrer une véritable légende dans un tel endroit !</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Mais... Mais qu'est-ce que c'est que ça ?</Page>
    </Text>
</VillagerDialog>
