<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1015" huntingZoneId="27" voiceTypeId="257" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">Mon mari ! Je cherche mon époux !</Page>
    </Text>
    <Text id="101" endSocial="14">
        <Page social="4" voiceTypeId="0">Par ici ! Mais aidez-nous donc ! Ici !</Page>
    </Text>
    <Text id="102" endSocial="14">
        <Page social="4" voiceTypeId="0">Je me fais du souci pour mon époux !</Page>
    </Text>
    <Text id="103" endSocial="14">
        <Page social="4" voiceTypeId="0">Un grand merci ! Nous allons maintenant pouvoir nous échapper !</Page>
    </Text>
</VillagerDialog>
