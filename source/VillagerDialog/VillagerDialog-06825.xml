<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="5033" huntingZoneId="528" voiceTypeId="136" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="5">
        <Page social="5" voiceTypeId="136">&lt;PCNAME&gt;, vous êtes mon épée.&lt;BR&gt;&lt;BR&gt;Je sais que vous me rendrez de bons services.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">J'ai entendu dire que les argons sont arrivés.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Nous ne devons surtout pas les laisser mettre Arborea en péril !</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Combattez pour moi et venez m'informer de l'ampleur de leur puissance.</Page>
    </Text>
</VillagerDialog>
