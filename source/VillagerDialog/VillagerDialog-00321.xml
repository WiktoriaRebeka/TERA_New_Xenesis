<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1016" huntingZoneId="27" voiceTypeId="10" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">Par la déesse !&lt;BR&gt;J'ai du mal à croire qu'il reste des survivants par ici !&lt;BR&gt;Nous devons fuir au plus vite avant que les papillons ne rappliquent !&lt;BR&gt;Allez, partons d'ici !</Page>
    </Text>
    <Text id="101" endSocial="14">
        <Page social="4" voiceTypeId="0">Mille mercis, chère déesse !</Page>
    </Text>
    <Text id="102" endSocial="14">
        <Page social="4" voiceTypeId="0">Je me fais du souci pour mes camarades !</Page>
    </Text>
    <Text id="103" endSocial="14">
        <Page social="4" voiceTypeId="0">Sauvez-les, je vous en prie.</Page>
    </Text>
</VillagerDialog>
