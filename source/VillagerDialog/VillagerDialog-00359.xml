    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">J'ai la conviction que tous ceux que nous n'avons pas encore retrouvés rentreront bientôt à la maison.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Quelqu'un est coincé là-bas !</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Est-il encore en vie ?</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Nous nous écrasons !</Page>
    </Text>
