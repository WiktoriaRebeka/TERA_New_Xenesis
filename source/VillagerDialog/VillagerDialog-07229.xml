<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="102" huntingZoneId="827" voiceTypeId="170" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="4">
        <Page social="4" voiceTypeId="170">Il me tarde de dormir à nouveau&amp;nbsp;! Je vis des aventures si merveilleuses dans mes rêves&amp;nbsp;!</Page>
    </Text>
    <Text id="100" endSocial="0">
        <Page social="0" voiceTypeId="0">Tiaran, né du chagrin et baigné de lumière.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Une vie dans les songes, avant qu'ils ne s'achèvent.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Tes miracles nous offrent notre Vision d'éther.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">La Vision nous révèle le monde dont les dieux rêvent.</Page>
    </Text>
    <Text id="200" endSocial="0">
        <Page social="0" voiceTypeId="0">Qu'est-ce qui se passe ici ?</Page>
    </Text>
</VillagerDialog>
