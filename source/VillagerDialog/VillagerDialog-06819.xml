<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="5026" huntingZoneId="528" voiceTypeId="270" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">Je suis Gislan, commandant de Velika.</Page>
    </Text>
    <Text id="101" endSocial="12">
        <Page social="4" voiceTypeId="0">De quoi s'agit-il ? Ne savez-vous donc pas comme la situation est désespérée à Khanovar, commandant Helkan ?</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">La décision n'est pas facile à prendre.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Hum, elle aussi, elle est d'une aide précieuse. Je comprends.</Page>
    </Text>
</VillagerDialog>
