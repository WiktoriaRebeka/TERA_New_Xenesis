<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="100" huntingZoneId="2002" voiceTypeId="324" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="1">
        <Page social="2" voiceTypeId="324">Oh, loué soit la déesse !&lt;BR&gt;Je n'en reviens pas que des étrangers viennent nous sauver.</Page>
    </Text>
    <Text id="101" endSocial="1">
        <Page social="2" voiceTypeId="324">Vous... Vous êtes des étrangers...</Page>
    </Text>
    <Text id="102" endSocial="1">
        <Page social="2" voiceTypeId="324">Je connais un habitant du marécage qui pourra vous aider à dénicher le remède.</Page>
    </Text>
    <Text id="103" endSocial="1">
        <Page social="2" voiceTypeId="324">Ah, pour ça, demandez de l'aide à Bashik.</Page>
    </Text>
    <Text id="104" endSocial="1">
        <Page social="2" voiceTypeId="324">Votre camarade ? Non, je ne l'ai pas vu.</Page>
    </Text>
    <Text id="105" endSocial="1">
        <Page social="2" voiceTypeId="324">Longez la route et vous finirez par tomber sur lui.</Page>
    </Text>
</VillagerDialog>
