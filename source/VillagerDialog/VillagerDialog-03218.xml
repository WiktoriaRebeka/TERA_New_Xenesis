<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="2064" huntingZoneId="183" voiceTypeId="26" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">Je m'appelle Rumin.&lt;BR&gt;&lt;BR&gt;On me surnomme aussi l'infatigable vagabond d'Arborea.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="4" voiceTypeId="0">Regardez-moi cet œuf.&lt;BR&gt;Je l'ai obtenu auprès d'un fantôme des Bois intemporels.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="4" voiceTypeId="0">J'espère que tout va bien se passer.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">C'est une franche réussite !</Page>
    </Text>
</VillagerDialog>
