<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="3000" huntingZoneId="2502" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">Ah, vous voilà !</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="0">Thulsa a volé le fragment de la déesse dans la Tour de Shara.</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="0">Je ne sais pas ce qu'il compte en faire, mais ses intentions ne sont certainement pas louables.</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="0">Nous devons le récupérer avant qu'il ne soit trop tard.</Page>
    </Text>
    <Text id="5" endSocial="0">
        <Page social="0" voiceTypeId="0">Discutons de tout le reste en chemin. &lt;BR&gt;Suivez-moi.</Page>
    </Text>
    <Text id="6" endSocial="0">
        <Page social="0" voiceTypeId="0">Ah, j'y pense... La femme qui était auprès de Thulsa...</Page>
    </Text>
    <Text id="7" endSocial="0">
        <Page social="0" voiceTypeId="0">Comment dire... &lt;BR&gt;Tout ceci ne me dit rien qui vaille.</Page>
    </Text>
    <Text id="8" endSocial="0">
        <Page social="0" voiceTypeId="0">Oh non.&lt;BR&gt;Ça va chauffer !</Page>
    </Text>
</VillagerDialog>
