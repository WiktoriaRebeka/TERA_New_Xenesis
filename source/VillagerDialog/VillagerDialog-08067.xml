    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Qui êtes-vous ?</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Vous pensiez que ce serait si facile ?</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Je vais tenir le monde à deux mains.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Vous souhaitez desceller mon corps ?</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Débarrassez-moi juste de ce sceau et je pourrai vous aider.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">Argh...</Page>
    </Text>
