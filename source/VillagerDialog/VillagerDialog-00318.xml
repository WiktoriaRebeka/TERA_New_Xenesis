<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1003" huntingZoneId="27" voiceTypeId="291" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="291">Il y a toujours plus de poudre de gemmes, à cause des papillons !</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="291">Laissez-moi m'en charger !</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="291">Comment l'aéronef a-t-il bien pu s'écraser ?</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="291">Secourez les survivants !</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="291">Cherchons les villageois !</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="291">Par ici.</Page>
    </Text>
</VillagerDialog>
