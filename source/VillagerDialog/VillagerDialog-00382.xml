<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1007" huntingZoneId="29" voiceTypeId="289" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="289">Comment ? Vous prétendez que ça a quelque chose à voir avec la cristallisation ?&lt;BR&gt;&lt;BR&gt;Bah, la décision d'Élion est surcotée.&lt;BR&gt;L'énorme erreur que vous commettez là se retournera contre vous.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="289">Cessez immédiatement !</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="289">J'ai juste essayé de limiter la casse !</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="289">Bon, il faut que j'y aille.</Page>
    </Text>
</VillagerDialog>
