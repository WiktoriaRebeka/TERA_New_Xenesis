<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1005" huntingZoneId="29" voiceTypeId="291" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="291">Oh non !&lt;BR&gt;&lt;BR&gt;Je sais bien que ce n'est jamais plaisant de les croiser....&lt;BR&gt;&lt;BR&gt;Mais... pourquoi se sentent-ils obligés d'être aussi brutaux ? Je ne les comprends pas.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="291">C'est ce que j'allais dire !</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="291">Ça va être vite réglé !</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="291">Comment peut-on faire pareille chose à une petite fille ?</Page>
    </Text>
</VillagerDialog>
