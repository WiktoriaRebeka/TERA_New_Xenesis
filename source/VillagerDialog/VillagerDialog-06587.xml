<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="2027" huntingZoneId="505" voiceTypeId="135" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="24">
        <Page social="0" voiceTypeId="0">La paix ! Pour laquelle nous avons travaillé si dur !&lt;BR&gt;Gardien, je vous en supplie, emmenez les survivants en lieu sûr.</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="0">Emmener les survivants en lieu sûr !</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="0">Montrez-vous !</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="0">La déesse... Velika... argh...</Page>
    </Text>
    <Text id="5" endSocial="0">
        <Page social="0" voiceTypeId="0">Apportez-moi les survivants. Nous allons quitter cet endroit au plus vite !</Page>
    </Text>
    <Text id="6" endSocial="0">
        <Page social="0" voiceTypeId="0">Téléportons-nous à l'aide du parchemin. Nous devons emmener tous les survivants en lieu sûr !</Page>
    </Text>
</VillagerDialog>
