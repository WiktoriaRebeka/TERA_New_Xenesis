    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="25">Vous semblez vraiment impatient d'aller à la fête !</Page>
    </Text>
    <Text id="2" endSocial="4">
        <Page social="0" voiceTypeId="25">Vous semblez vraiment impatient d'aller à la fête !</Page>
    </Text>
    <Text id="3" endSocial="14">
        <Page social="0" voiceTypeId="25">Si ça continue ainsi, le monde... Arborea court à sa perte ! S'il vous plaît, laissez-moi entrer ! Je vous en supplie !</Page>
    </Text>
    <Text id="4" endSocial="0">
        <Page social="0" voiceTypeId="25">La déesse compte-t-elle vraiment... C'en est-il donc fini de ce monde ?&lt;BR&gt;</Page>
    </Text>
    <Text id="5" endSocial="0">
        <Page social="0" voiceTypeId="25">De tout... La fin de toutes choses...</Page>
    </Text>
    <Text id="6" endSocial="0">
        <Page social="0" voiceTypeId="25">Hé, vous ! Vous, là !</Page>
    </Text>
</VillagerDialog>
