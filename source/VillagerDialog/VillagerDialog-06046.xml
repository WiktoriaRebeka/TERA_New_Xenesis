<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="5001" huntingZoneId="411" voiceTypeId="189" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">Serait-ce la première fois que vous venez ici ?&lt;BR&gt;&lt;BR&gt;Ce lieu rassemble les meilleurs forgerons du continent.&lt;BR&gt;&lt;BR&gt;Jetez donc un œil alentour.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Bien&amp;nbsp;! On commence&amp;nbsp;?</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Hmm... Pas encore. Ce n'est pas assez&amp;nbsp;!</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Les gars&amp;nbsp;!</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Maintenant, l'essence du noyau...</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">Enfin, j'ai réussi&amp;nbsp;!</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">C'est désormais accompli !</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0" voiceTypeId="0">Oh, Élion, cela faisait bien longtemps.</Page>
    </Text>
</VillagerDialog>
