<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="30000" huntingZoneId="2501" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Trop tard ! Vous avez déjà investi un corps.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Une attaque puissante.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Uhhh...</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Misère, il nous a échappé.</Page>
    </Text>
    <Text id="112" endSocial="0">
        <Page social="0" voiceTypeId="0">Je vais pourchasser Thulsa, le dieu de la mort. Vous, occupez-vous de cet endroit.</Page>
    </Text>
    <Text id="113" endSocial="0">
        <Page social="0" voiceTypeId="0">Quand vous aurez fini, venez m'aider à les arrêter.</Page>
    </Text>
    <Text id="114" endSocial="0">
        <Page social="0" voiceTypeId="0">Faites de votre mieux.</Page>
    </Text>
</VillagerDialog>
