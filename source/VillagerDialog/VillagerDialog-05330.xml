<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="2010" huntingZoneId="247" voiceTypeId="267" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4" voiceTypeId="0">Je m'appelle Yasring. Nous nous efforçons de reconstruire la Forêt de Tirkai.&lt;BR&gt;Je me demande bien quand cette guerre va enfin s'arrêter... Je prie surtout pour que les fées n'aient plus à en souffrir.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">J'espère que nous nous reverrons.</Page>
    </Text>
</VillagerDialog>
