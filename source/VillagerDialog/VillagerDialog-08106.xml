    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">Ah, vous voilà !&lt;BR&gt;L'attente a été bien longue.</Page>
    </Text>
    <Text id="2" endSocial="0">
        <Page social="0" voiceTypeId="0">Bien ! Vous prenez la gauche ! Et je pars à droite ! &lt;BR&gt;Déblayons tout ce qui bouge !</Page>
    </Text>
    <Text id="3" endSocial="0">
        <Page social="0" voiceTypeId="0">Encore une fois, ce corps va réaliser une performance de premier ordre.</Page>
    </Text>
</VillagerDialog>
