<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="1000" huntingZoneId="27" voiceTypeId="95" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="0">Nous savons où l'aéronef se trouve.&lt;BR&gt;Nous avons longé la crête de la montagne et l'avons aperçu assez vite.&lt;BR&gt;En revanche, le chemin du retour nous a pris une éternité.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">Beau travail !</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">Grâce à vous, nous n'avons plus de souci à nous faire.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">Il n'y a pas une minute à perdre !</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">Vite ! Je me fais du souci pour les villageois !</Page>
    </Text>
</VillagerDialog>
