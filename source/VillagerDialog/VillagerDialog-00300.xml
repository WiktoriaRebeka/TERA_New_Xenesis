<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="502" huntingZoneId="27" voiceTypeId="291" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="0" voiceTypeId="291">Il était moins une !&lt;BR&gt;Ces Humains sont sains et saufs et nous pouvons donc rentrer au village.&lt;BR&gt;Nous pourrons nous occuper des papillons après avoir ramené les villageois en lieu sûr.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="291">Je peux vous êtes utile !</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="291">Venez, par ici.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="291">Ce sont là tous les survivants ?</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="291">Qu'est-ce que c'était que ce bruit ?</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="291">Je n'ai pas d'autre choix que d'utiliser ce pouvoir.</Page>
    </Text>
</VillagerDialog>
